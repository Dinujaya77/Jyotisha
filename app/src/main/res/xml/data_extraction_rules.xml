<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- ADR-005: covers the complete directory and replacement/temporary files. -->
        <exclude domain="root" path="no_backup/location-data" />
        <exclude domain="device_root" path="no_backup/location-data" />
    </cloud-backup>
    <device-transfer>
        <!-- Device transfer has independent rules on Android 12+. -->
        <exclude domain="root" path="no_backup/location-data" />
        <exclude domain="device_root" path="no_backup/location-data" />
    </device-transfer>
</data-extraction-rules>
